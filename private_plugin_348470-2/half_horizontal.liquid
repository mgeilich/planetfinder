<div class="layout">
  <div class="grid grid--cols-2 portrait:grid--cols-1 h--full">
    <!-- Panel 1: Sky Map -->
    <div class="flex flex--col justify--center items--center">
      <img src="https://planetfinder-web-2605.web.app/api/sky.svg?lat={{ latitude }}&lon={{ longitude }}&v=126" 
           class="image image-dither" />
    </div>
    <!-- Panel 2: Moon Phase & Altitude -->
    <div class="flex flex--col justify--start gap--2 lg:gap--4 p--3 lg:p--6 border--left portrait:border--top portrait:border--left-none">
      <div class="flex flex--row justify--between items--center w--full border--bottom pb--2 lg:pb--4">
        <div class="flex flex--col gap--1 lg:gap--2">
          <span class="text--xsmall lg:text--small label text--bold text--black">LOCAL TIME & COORDINATES</span>
          <span class="text--small lg:text--large text--bold">{{ last_updated }} ({{ latitude }}, {{ longitude }})</span>
        </div>
        <div class="flex flex--row items--center gap--2 lg:gap--4">
          <span class="value--large lg:value--xxlarge">{{ moon_phase_emoji }}</span>
          <div class="flex flex--col justify--center">
            <span class="text--xsmall lg:text--base text--bold">{{ moon_phase }}</span>
            <span class="text--xxsmall lg:text--small label text--black">{{ moon_illumination }}% lit</span>
          </div>
        </div>
      </div>
      <div class="flex flex--row portrait:flex--col gap--4 lg:gap--8 mt--1 lg:mt--3 w--full">
        <div class="flex flex--col gap--1 lg:gap--2 flex--1">
          <span class="text--xsmall lg:text--small label text--bold text--black">UPCOMING EVENT</span>
          {% if next_event.title %}
            <span class="text--xsmall lg:text--large text--bold">{{ next_event.title }}</span>
            <span class="text--xsmall lg:text--base label text--black">{{ next_event.date_formatted }}</span>
          {% else %}
            <span class="text--xsmall lg:text--base label text--black">No events soon</span>
          {% endif %}
        </div>
        <div class="flex flex--col gap--1 lg:gap--2 flex--1">
          <span class="text--xsmall lg:text--small label text--bold text--black">ALTITUDE/HEADING</span>
          <div class="flex flex--row flex--wrap gap--x-3 lg:gap--x-6 gap--y-1 lg:gap--y-2">
            {% for planet in planets %}
              {% if planet.visible %}
                <span class="text--xsmall lg:text--base">{{ planet.name }}: <strong>{{ planet.altitude_formatted }} <span class="text--xxsmall lg:text--small text--bold text--black">{{ planet.compass_direction }}</span></strong></span>
              {% endif %}
            {% endfor %}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
