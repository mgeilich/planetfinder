<div class="view layout padding--none bg--white">
  <div class="flex flex--row portrait:flex--col w--full h--full">
    <!-- Panel 1: Sky Map (60% width / 480px wide) -->
    <div class="flex flex--col justify--center items--center w--[480px] h--[480px] portrait:w--full portrait:h--[240px]">
      <img src="https://planetfinder-web-2605.web.app/api/sky.svg?lat={{ latitude }}&lon={{ longitude }}&v=12" 
           class="image image-dither w--[480px] h--[480px] portrait:w--[240px] portrait:h--[240px]" />
    </div>
    <!-- Panel 2: Altitude Panel (112px wide) -->
    <div class="flex flex--col justify--start gap--3 w--[112px] h--[480px] pt--4 pb--4 pl--1 pr--1 border--left portrait:border--top portrait:w--full portrait:h--auto">
      <span class="text--small label text--bold text--black text--center display--block w--full mb--1">ALTITUDE</span>
      <div class="flex flex--col gap--2 w--full">
        {% for planet in planets %}
          {% if planet.visible %}
            <div class="flex flex--row justify--between items--center pb--1 border--bottom">
              <span class="text--small text--bold">{{ planet.name }}</span>
              <span class="text--small">{{ planet.altitude_formatted }}</span>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
    <!-- Panel 3: Info Panel (208px wide) -->
    <div class="flex flex--col justify--start gap--4 w--[208px] h--[480px] pt--4 pb--4 pl--3 pr--3 border--left portrait:border--top portrait:w--full portrait:h--auto">
      <!-- Time & Coordinates Section -->
      <div class="flex flex--col gap--2 pb--3 w--full border--bottom">
        <div class="flex flex--row justify--between items--center">
          <span class="text--bold text--black">Latitude</span>
          <span class="text--bold">{{ latitude }}</span>
        </div>
        <div class="flex flex--row justify--between items--center">
          <span class="text--bold text--black">Longitude</span>
          <span class="text--bold">{{ longitude }}</span>
        </div>
        <div class="flex flex--row justify--between items--center mt--1">
          <span class="text--bold text--black">Local Time</span>
          <span class="text--bold">{{ last_updated }}</span>
        </div>
      </div>
      <!-- Moon Phase Card -->
      <div class="bg--white rounded border flex flex--col gap--2 w--full pt--2 pb--2 pl--3 pr--3">
        <span class="text--small label text--bold text--black">MOON PHASE</span>
        <div class="flex flex--row items--center gap--3 mt--1">
          <span class="value--large">{{ moon_phase_emoji }}</span>
          <div class="flex flex--col justify--center gap--1">
            <span class="text--small text--bold">{{ moon_phase }}</span>
            <span class="text--xsmall label text--black">{{ moon_illumination }}% lit</span>
          </div>
        </div>
      </div>
      <!-- Upcoming Event Card -->
      <div class="bg--white rounded border flex flex--col gap--2 w--full pt--2 pb--2 pl--3 pr--3">
        <span class="text--small label text--bold text--black">UPCOMING EVENT</span>
        {% if next_event.title %}
          <div class="flex flex--col gap--1">
            <span class="text--xsmall text--bold">{{ next_event.title }}</span>
            <span class="text--xsmall label text--black">{{ next_event.date_formatted }}</span>
          </div>
          <div class="text--xsmall mt--1">
            {{ next_event.description }}
          </div>
        {% else %}
          <span class="text--xsmall label text--black">No events soon</span>
        {% endif %}
      </div>
    </div>
  </div>
</div>