<div class="layout">
  <div class="grid grid--cols-2 portrait:grid--cols-1">
    <!-- Column 1: Sky Map (Top) & Altitude/Heading (Bottom) -->
    <div class="flex flex--col">
      <!-- Sky Map -->
      <img src="https://planetfinder-web-2605.web.app/api/sky.svg?lat={{ latitude }}&lon={{ longitude }}&width=670&height=330&v=126" 
           class="image image-dither block mt--5 lg:mt--8" />

      <!-- Altitude / Heading -->
      <div class="pl--4 pr--4 pt--2 lg:pt--4 border--top relative">
        <div class="grid grid--cols-2 gap--4 lg:gap--8 w--full">
          {% for planet in planets %}
            {% if planet.visible %}
              <div class="flex flex--row items--center border--bottom px--1 py--1">
                <!-- Column 1: Planet Name -->
                <div class="text--base lg:text--xlarge text--bold text--black flex--1 text--left">
                  {{ planet.name }}
                </div>
                
                <!-- Column 2: Altitude -->
                <div class="text--base lg:text--xlarge text--bold text--black flex--1 text--left">
                  {{ planet.altitude_formatted }}
                </div>
                
                <!-- Column 3: Heading -->
                <div class="text--base lg:text--xlarge text--bold text--black flex--1 text--right">
                  {{ planet.compass_direction }}
                </div>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>
    
    <div class="hidden portrait:visible divider"></div>
    
    <!-- Panel 3: Info Panel -->
    <div class="flex flex--col justify--center border--left portrait:border--top portrait:border--left-none p--2 lg:p--4">
      <div class="flex flex--col gap--3 lg:gap--5 w--full">
        <div class="flex flex--col gap--1 lg:gap--2 pb--2 lg:pb--4 w--full border--bottom text--xsmall lg:text--base">
          <div class="flex flex--row justify--between items--center">
            <span class="text--bold text--black">Lat</span>
            <span class="text--bold">{{ latitude }}</span>
          </div>
          <div class="flex flex--row justify--between items--center">
            <span class="text--bold text--black">Lon</span>
            <span class="text--bold">{{ longitude }}</span>
          </div>
          <div class="flex flex--col gap--0 mt--1 lg:mt--2">
            <span class="text--bold text--black">Time</span>
            <span class="text--bold text--black mt--1">{{ last_updated }}</span>
          </div>
        </div>
        
        <div class="bg--white rounded border flex flex--col gap--1 lg:gap--2 w--full pt--1 lg:pt--3 pb--1 lg:pb--3 pl--2 lg:pl--4 pr--2 lg:pr--4">
          <span class="text--xxsmall lg:text--small label text--bold text--black">MOON PHASE</span>
          <div class="flex flex--row items--center gap--2 lg:gap--4 mt--1">
            <span class="value--large lg:value--xxlarge">{{ moon_phase_emoji }}</span>
            <div class="flex flex--col justify--center">
              <span class="text--xxsmall lg:text--small text--bold text--black">{{ moon_phase }}</span>
              <span class="text--xxsmall lg:text--small label text--black">{{ moon_illumination }}% lit</span>
            </div>
          </div>
        </div>
        
        <div class="bg--white rounded border flex flex--col gap--1 lg:gap--2 w--full pt--1 lg:pt--3 pb--1 lg:pb--3 pl--2 lg:pl--4 pr--2 lg:pr--4">
          <span class="text--xxsmall lg:text--small label text--bold text--black">UPCOMING EVENT</span>
          {% if next_event.title %}
            <div class="flex flex--col gap--0">
              <span class="text--xxsmall lg:text--small text--bold text--black">{{ next_event.title }}</span>
              <span class="text--xxsmall lg:text--small label text--black mb--1 lg:mb--2">{{ next_event.date_formatted }}</span>
              <span class="text--xxsmall lg:text--small text--black">{{ next_event.description }}</span>
            </div>
          {% else %}
            <span class="text--xxsmall lg:text--small label text--black">No events soon</span>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</div>
