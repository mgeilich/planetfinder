<div class="view layout padding--none bg--white">
  <div class="flex flex--row portrait:flex--col w--full h--full">
    <!-- Panel 1: Sky Map (680px wide, overlaps into altitude column) -->
    <div class="flex flex--col justify--center w--[680px] h--[480px] portrait:w--full portrait:h--[240px]" style="margin-right: -140px;">
      <img src="https://planetfinder-web-2605.web.app/api/sky.svg?lat={{ latitude }}&lon={{ longitude }}&v=115" 
           class="image image-dither w--[680px] h--[480px] portrait:w--[240px] portrait:h--[240px]"
           style="display: block;" />
    </div>

    <!-- Panel 2: Altitude Panel (130px wide, transparent overlay, vertically centered) -->
    <div class="w--[130px] h--[480px] pl--2 pr--2 border--left portrait:border--top portrait:w--full portrait:h--auto" style="position: relative;">
      <table style="width: 100%; height: 100%; border-collapse: collapse;">
        <tbody>
          <tr>
            <td style="vertical-align: middle; padding: 0;">
              <table style="width: 100%; border-collapse: collapse;">
                <thead>
                  <tr>
                    <td style="width: 22px; border: none;"></td>
                    <th colspan="2" class="text--base text--bold text--black" style="text-align: center; border: none; padding-bottom: 8px;">POSITION</th>
                  </tr>
                </thead>
                <tbody>
                  {% for planet in planets %}
                    {% if planet.visible %}
                      <tr class="border--bottom" style="height: 32px;">
                        <td style="width: 22px; border: none;"></td>
                        <td class="text--center text--base text--bold text--black" style="text-align: center; border: none; vertical-align: middle;">{{ planet.name }}</td>
                        <td class="text--right text--base text--bold text--black" style="width: 45px; text-align: right; border: none; vertical-align: middle; white-space: nowrap;">
                          {{ planet.altitude_formatted }} <span style="font-size: 11px; color: #808080; font-weight: normal;">{{ planet.compass_direction }}</span>
                        </td>
                      </tr>
                    {% endif %}
                  {% endfor %}
                </tbody>
              </table>
            </td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- Panel 3: Info Panel (130px wide, vertically centered) -->
    <div class="w--[130px] h--[480px] border--left portrait:border--top portrait:w--full portrait:h--auto">
      <table style="width: 100%; height: 100%; border-collapse: collapse;">
        <tbody>
          <tr>
            <td style="vertical-align: middle; padding: 8px;">
              <div class="flex flex--col gap--3 w--full">
                <div class="flex flex--col gap--1 pb--2 w--full border--bottom text--xsmall">
                  <div class="flex flex--row justify--between items--center">
                    <span class="text--bold text--black">Lat</span>
                    <span class="text--bold">{{ latitude }}</span>
                  </div>
                  <div class="flex flex--row justify--between items--center">
                    <span class="text--bold text--black">Lon</span>
                    <span class="text--bold">{{ longitude }}</span>
                  </div>
                  <div class="flex flex--col gap--0 mt--1">
                    <span class="text--bold text--black">Time</span>
                    <span class="text--bold text--black mt--1">{{ last_updated }}</span>
                  </div>
                </div>
                <div class="bg--white rounded border flex flex--col gap--1 w--full pt--1 pb--1 pl--2 pr--2">
                  <span class="text--xxsmall label text--bold text--black">MOON PHASE</span>
                  <div class="flex flex--row items--center gap--2 mt--1">
                    <span class="value--large">{{ moon_phase_emoji }}</span>
                    <div class="flex flex--col justify--center">
                      <span class="text--xxsmall text--bold text--black">{{ moon_phase }}</span>
                      <span class="text--xxsmall label text--black">{{ moon_illumination }}% lit</span>
                    </div>
                  </div>
                </div>
                <div class="bg--white rounded border flex flex--col gap--1 w--full pt--1 pb--1 pl--2 pr--2">
                  <span class="text--xxsmall label text--bold text--black">UPCOMING EVENT</span>
                  {% if next_event.title %}
                    <div class="flex flex--col gap--0">
                      <span class="text--xxsmall text--bold text--black">{{ next_event.title }}</span>
                      <span class="text--xxsmall label text--black mb--1">{{ next_event.date_formatted }}</span>
                      <span class="text--xxsmall text--black" style="line-height: 1.2;">{{ next_event.description }}</span>
                    </div>
                  {% else %}
                    <span class="text--xxsmall label text--black">No events soon</span>
                  {% endif %}
                </div>
              </div>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</div>
