<div class="view layout padding--none bg--white">
  <div class="flex flex--row w--full h--full lg:flex--row">
    <!-- Left Panel: Sky Map -->
    <div class="flex flex--col justify--center items--center w--[160px] h--[240px] lg:w--[160px]">
      <img src="https://planetfinder-web-2605.web.app/api/sky.svg?lat={{ latitude }}&lon={{ longitude }}&v=100" 
           class="image image-dither w--[160px] h--[160px] lg:w--[160px] lg:h--[160px]" />
    </div>
    <!-- Right Panel: Info -->
    <div class="flex flex--col justify--center gap--2 w--[240px] h--[240px] pt--2 pb--2 pl--2 pr--2 border--left lg:pl--2">
      <div class="flex flex--row items--center gap--2">
        <span class="value--large">{{ moon_phase_emoji }}</span>
        <div class="flex flex--col justify--center">
          <span class="text--xsmall text--bold">{{ moon_phase }}</span>
          <span class="text--xxsmall label text--black">{{ moon_illumination }}% lit</span>
        </div>
      </div>
      <div class="flex flex--col gap--1">
        <span class="text--xsmall label text--bold text--black">COORDINATES & TIME</span>
        <span class="text--xsmall text--bold">{{ latitude }}, {{ longitude }}</span>
        <span class="text--xsmall text--bold">{{ last_updated }}</span>
      </div>
    </div>
  </div>
</div>
