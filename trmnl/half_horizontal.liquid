<div class="view layout padding--none bg--white">
  <div class="flex flex--row w--full h--full">
    <!-- Panel 1: Sky Map (240px wide) -->
    <div class="flex flex--col justify--center items--center w--[240px] h--[240px] lg:w--[240px]">
      <img src="https://planetfinder-web-2605.web.app/api/sky.svg?lat={{ latitude }}&lon={{ longitude }}&v=118" 
           class="image image-dither w--[240px] h--[240px] lg:w--[240px] lg:h--[240px]" />
    </div>
    <!-- Panel 2: Moon Phase & Altitude (560px wide) -->
    <div class="flex flex--col justify--start gap--2 w--[560px] h--[240px] pt--2 pb--2 pl--3 pr--3 border--left lg:pl--3">
      <div class="flex flex--row justify--between items--center w--full">
        <div class="flex flex--col gap--1">
          <span class="text--xsmall label text--bold text--black">LOCAL TIME & COORDINATES</span>
          <span class="text--small text--bold">{{ last_updated }} ({{ latitude }}, {{ longitude }})</span>
        </div>
        <div class="flex flex--row items--center gap--2">
          <span class="value--large">{{ moon_phase_emoji }}</span>
          <div class="flex flex--col justify--center">
            <span class="text--xsmall text--bold">{{ moon_phase }}</span>
            <span class="text--xxsmall label text--black">{{ moon_illumination }}% lit</span>
          </div>
        </div>
      </div>
      <div class="flex flex--row justify--between items--start w--full mt--1">
        <div class="flex flex--col gap--1 w--[260px] lg:w--[260px]">
          <span class="text--xsmall label text--bold text--black">UPCOMING EVENT</span>
          {% if next_event.title %}
            <span class="text--xsmall text--bold">{{ next_event.title }}</span>
            <span class="text--xsmall label text--black">{{ next_event.date_formatted }}</span>
          {% else %}
            <span class="text--xsmall label text--black">No events soon</span>
          {% endif %}
        </div>
        <div class="flex flex--col gap--1 w--[260px] lg:w--[260px]">
          <span class="text--xsmall label text--bold text--black">ALTITUDE/HEADING</span>
          <div class="flex flex--row flex--wrap gap--x-3 gap--y-1">
            {% for planet in planets %}
              {% if planet.visible %}
                <span class="text--xsmall">{{ planet.name }}: <strong>{{ planet.altitude_formatted }} <span style="font-size: 10px; color: #808080; font-weight: normal;">{{ planet.compass_direction }}</span></strong></span>
              {% endif %}
            {% endfor %}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
