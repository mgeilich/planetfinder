<div class="layout">
  <div class="grid grid--cols-2 portrait:grid--cols-1 h--full">
    <!-- Panel 1: Sky Map -->
    <div class="flex flex--col flex--center-x flex--center-y">
      <!-- Map sized to the OG and TRMNL X boxes; lazy loading skips the hidden one -->
      <img src="https://planetfinder-web-2605.web.app/api/sky.svg?lat={{ latitude }}&lon={{ longitude }}&width=400&height=185" loading="lazy"
           class="image lg:hidden" />
      <img src="https://planetfinder-web-2605.web.app/api/sky.svg?lat={{ latitude }}&lon={{ longitude }}&width=400&height=260" loading="lazy"
           class="image hidden lg:visible" />
    </div>
    <!-- Panel 2: Moon Phase & Altitude -->
    <div class="flex flex--col gap--small lg:gap--medium p--3 lg:p--6">
      <div class="flex flex--row flex--between flex--center-y w--full pb--2 lg:pb--4">
        <div class="flex flex--col gap--xsmall lg:gap--small">
          <span class="text--small label font--bold text--black">LOCAL TIME & COORDINATES</span>
          <span class="text--small lg:text--large font--bold">{{ last_updated }} ({{ latitude }}, {{ longitude }})</span>
        </div>
        <div class="flex flex--row flex--center-y gap--small lg:gap--medium">
          <span class="value--large lg:value--xxlarge">{{ moon_phase_emoji }}</span>
          <div class="flex flex--col flex--center-x">
            <span class="text--small lg:text--base font--bold">{{ moon_phase }}</span>
            <span class="text--small label text--black">{{ moon_illumination }}% lit</span>
          </div>
        </div>
      </div>
      <div class="divider"></div>
      <div class="flex flex--row portrait:flex--col gap--medium lg:gap--large mt--1 lg:mt--3 w--full">
        <div class="flex flex--col gap--xsmall lg:gap--small grow">
          <span class="text--small label font--bold text--black">UPCOMING EVENT</span>
          {% if next_event.title %}
            <span class="text--small lg:text--large font--bold">{{ next_event.title }}</span>
            <span class="text--small lg:text--base label text--black">{{ next_event.date_formatted }}</span>
          {% else %}
            <span class="text--small lg:text--base label text--black">No events soon</span>
          {% endif %}
        </div>
        <div class="flex flex--col gap--xsmall lg:gap--small grow">
          <span class="text--small label font--bold text--black">ALTITUDE/HEADING</span>
          <div class="flex flex--row flex--wrap gap--small lg:gap--medium">
            {% for planet in planets %}
              {% if planet.visible %}
                <span class="text--small lg:text--base">{{ planet.name }}: <strong>{{ planet.altitude_formatted }} <span class="text--small font--bold text--black">{{ planet.compass_direction }}</span></strong></span>
              {% endif %}
            {% endfor %}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

{% render "title_bar", coords_error: coords_error, instance: trmnl.plugin_settings.instance_name %}
