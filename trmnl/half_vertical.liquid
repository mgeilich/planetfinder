<div class="layout">
  <div class="flex flex--col w--full h--full">
    <!-- Top Panel: Sky Map -->
    <div class="flex flex--center w--full stretch-y">
      <!-- Map sized to the OG and TRMNL X boxes; lazy loading skips the hidden one -->
      <img src="https://planetfinder-web-2605.web.app/api/sky.svg?lat={{ latitude }}&lon={{ longitude }}&width=400&height=215" loading="lazy"
           class="image image--contain w--full h--full lg:hidden" />
      <img src="https://planetfinder-web-2605.web.app/api/sky.svg?lat={{ latitude }}&lon={{ longitude }}&width=400&height=290" loading="lazy"
           class="image image--contain w--full h--full hidden lg:visible" />
    </div>
    <div class="divider"></div>
    <!-- Bottom Panel: Stats -->
    <div class="flex flex--col flex--center-x gap--small lg:gap--medium p--3 lg:p--6">
      <div class="flex flex--row flex--between flex--center-y w--full">
        <div class="flex flex--col gap--xsmall lg:gap--small">
          <span class="text--small label font--bold text--black">COORDINATES & TIME</span>
          <span class="text--small lg:text--base font--bold">{{ latitude }}, {{ longitude }}</span>
          <span class="text--small lg:text--base font--bold">{{ last_updated }}</span>
        </div>
        <div class="flex flex--row flex--center-y gap--small lg:gap--medium">
          <span class="value--large lg:value--xxlarge">{{ moon_phase_emoji }}</span>
          <div class="flex flex--col flex--center-x">
            <span class="text--small lg:text--base font--bold">{{ moon_phase }}</span>
            <span class="text--small label text--black">{{ moon_illumination }}% lit</span>
          </div>
        </div>
      </div>
      <div class="flex flex--col gap--xsmall lg:gap--small w--full mt--1 lg:mt--3">
        <span class="text--small label font--bold text--black">UPCOMING EVENT</span>
        {% if next_event.title %}
          <span class="text--small lg:text--large font--bold">{{ next_event.title }}</span>
          <span class="text--small lg:text--base label text--black">{{ next_event.date_formatted }}</span>
          <span class="text--small lg:text--base">{{ next_event.description }}</span>
        {% else %}
          <span class="text--small lg:text--base label text--black">No events soon</span>
        {% endif %}
      </div>
    </div>
  </div>
</div>

{% render "title_bar", coords_error: coords_error, instance: trmnl.plugin_settings.instance_name %}
